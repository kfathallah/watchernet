# ─────────────────────────────────────────────────────────────────────────────
# WatcherNet – Variables d'environnement
# Copier ce fichier en `.env` et adapter les valeurs avant `docker compose up`.
# NE JAMAIS committer le fichier `.env` dans le dépôt.
# ─────────────────────────────────────────────────────────────────────────────

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DB_NAME=watchernet
# URI utilisée par le backend (inclut les credentials)
MONGO_URI=mongodb://admin:changeme@mongodb:27017/watchernet?authSource=admin

# ─── MediaMTX ────────────────────────────────────────────────────────────────
# URL de l'API REST MediaMTX (interne au réseau Docker)
MEDIAMTX_API_URL=http://mediamtx:9997

# ─── Backend FastAPI ──────────────────────────────────────────────────────────
# (Utilisé par le frontend pour les appels API)
VITE_API_BASE_URL=http://localhost:8000

# ─── Frontend React / Vite ────────────────────────────────────────────────────
# URL de base pour les flux WebRTC/WHEP (accessible depuis le navigateur)
VITE_WHEP_BASE_URL=http://localhost:8889
